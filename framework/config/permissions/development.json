{
  "profile": "development",
  "description": "Edicion de proyecto y ejecucion de checks permitidos, con comandos destructivos bloqueados.",
  "permissions": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "git reset *": "deny",
      "git checkout -- *": "deny"
    },
    "webfetch": "ask"
  }
}
